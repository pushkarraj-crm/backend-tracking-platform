ENVIRONMENT=production
PUBLIC_DOMAIN=relay.example.com
TLS_EMAIL=operations@example.com
PUBLIC_BASE_URL=https://relay.example.com
ALLOWED_HOSTS=["relay.example.com"]
CORS_ORIGINS=["https://app.example.com"]
DATABASE_URL=postgresql+psycopg://relay_runtime:URL_ENCODED_PASSWORD@DATABASE_HOST:25060/relay?sslmode=verify-full&sslrootcert=/run/certs/ca.crt
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
ENCRYPTION_KEY=GENERATE_WITH_FERNET_GENERATE_KEY
METRICS_TOKEN=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# For the Vercel API proxy, use the identical random value in its server environment.
PROXY_IP_SECRET=
REDIS_PASSWORD=GENERATE_A_RANDOM_URL_SAFE_PASSWORD
REDIS_URL=redis://:SAME_REDIS_PASSWORD@redis:6379/0
AUTO_CREATE_TABLES=false
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=false
FRONTEND_BASE_URL=https://app.example.com
TERMS_URL=
PRIVACY_URL=
LEGAL_VERSION=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=accounts@example.com
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=GENERATE_A_SEPARATE_WEBHOOK_SECRET
RAZORPAY_PLANS={"starter":"plan_REPLACE_STARTER","business":"plan_REPLACE_BUSINESS"}
OUTBOUND_ALLOWED_HOSTS=[]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
RATE_LIMIT_PER_MINUTE=600
SIGNUP_TRIAL_DAYS=15
TRACKING_CNAME=tracking.example.com
DOMAIN_CERTIFICATE_TOKEN=GENERATE_A_RANDOM_PERMISSION_TOKEN
GEOIP_DATABASE_PATH=/run/geoip/GeoLite2-Country.mmdb
BILLING_GRACE_HOURS=72
