# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://affiliate_app:replace-with-password@127.0.0.1:5433/affiliate_platform
AUTO_CREATE_TABLES=false
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=120
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
FRONTEND_BASE_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_REGISTRATION=true
TERMS_URL=
PRIVACY_URL=
LEGAL_VERSION=1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
REDIS_URL=
# Optional: enable only after a wildcard domain and PostgreSQL provisioner are configured.
COMPANY_DATABASES=false
COMPANY_BASE_DOMAIN=localhost
COMPANY_FRONTEND_PORT=3000
# Separate provisioner credential with CREATEDB/CREATEROLE (PostgreSQL 16+).
COMPANY_DATABASE_ADMIN_URL=
# Use the same random server-only secret in the Vercel proxy and backend for proxied API traffic.
PROXY_IP_SECRET=
